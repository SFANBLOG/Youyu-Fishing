APP_NAME=有渔渔具 AI Agent

# ---- MySQL（默认）----
DATABASE_URL=mysql://root:youyu123@127.0.0.1:3306/youyu
DB_RETRY=20
DB_RETRY_DELAY=2.0

# ---- Milvus 向量库 ----
VECTOR_BACKEND=milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=yy_knowledge_chunks
# 必须与所用 embedding 模型输出维度一致（bge-m3 / text-embedding-v3 为 1024，nomic 为 768）
EMBED_DIM=1024
MILVUS_TOPK=30

# ---- MinIO 对象存储 ----
STORAGE_BACKEND=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=youyu-uploads
MINIO_SECURE=false
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# ---- LangChain 主链路 ----
LLM_FRAMEWORK=langchain
LLM_TIMEOUT=30.0

# ---- 通用 ----
SECRET_KEY=change-this-secret-in-production
TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHUNK_SIZE=300
CHUNK_OVERLAP=60
